{
  "name": "electron-glasskit",
  "version": "0.1.0",
  "description": "Native Liquid Glass for Electron: glass that floats over your page, merges like liquid, and hosts real SwiftUI controls, driven from JavaScript, the DOM or React.",
  "keywords": [
    "electron",
    "macos",
    "liquid-glass",
    "glass",
    "vibrancy",
    "swiftui",
    "nsglasseffectview",
    "native",
    "react"
  ],
  "license": "MIT",
  "author": "OpenSource03",
  "contributors": [
    "Meridius Labs (https://github.com/Meridius-Labs)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSource03/electron-glasskit.git"
  },
  "bugs": {
    "url": "https://github.com/OpenSource03/electron-glasskit/issues"
  },
  "homepage": "https://github.com/OpenSource03/electron-glasskit#readme",
  "type": "module",
  "sideEffects": [
    "./dist/preload.js",
    "./dist/preload.cjs"
  ],
  "gypfile": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./renderer": {
      "import": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.js"
      },
      "require": {
        "types": "./dist/renderer.d.cts",
        "default": "./dist/renderer.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./preload": {
      "import": {
        "types": "./dist/preload.d.ts",
        "default": "./dist/preload.js"
      },
      "require": {
        "types": "./dist/preload.d.cts",
        "default": "./dist/preload.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prebuilds",
    "native/addon.cc",
    "native/binding.gyp",
    "native/include",
    "native/swift",
    "scripts/build-native.mjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "build:native": "node scripts/build-native.mjs",
    "build:all": "pnpm build:native && pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:swift": "node scripts/test-swift.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "example": "node scripts/run-example.mjs",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "electron": ">=35.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.0",
    "happy-dom": "^21.0.1",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
